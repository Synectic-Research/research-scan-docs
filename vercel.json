{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "research-scan-docs.vercel.app" }],
      "destination": "https://researchscan.synectic.org/$1",
      "permanent": true
    }
  ]
}
